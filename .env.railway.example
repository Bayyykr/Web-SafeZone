# ==============================================================================
# RAILWAY PRODUCTION ENVIRONMENT VARIABLES FOR GEOCRIME-WEB
# ==============================================================================
# Salin nilai variabel berikut ke tab "Variables" di Railway Dashboard Anda.

APP_NAME=GeoCrime
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Domain Railway otomatis: Railway menyediakan variabel ${{RAILWAY_PUBLIC_DOMAIN}}
# atau masukkan URL lengkap contoh: https://geocrime-production.up.railway.app
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# Pilih salah satu koneksi (mysql atau pgsql):
DB_CONNECTION=mysql

# TIPS RAILWAY:
# Jika Anda membuat service MySQL di project Railway yang sama,
# Laravel GeoCrime sudah dikonfigurasi untuk membaca variabel MYSQLHOST,
# MYSQLPORT, MYSQLDATABASE, MYSQLUSER, dan MYSQLPASSWORD secara otomatis!
#
# Namun jika ingin eksplisit mengikat ke service MySQL di Railway:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ------------------------------------------------------------------------------
# CONTAINER STARTUP AUTOMATIONS
# ------------------------------------------------------------------------------
# Jalankan migrasi database otomatis setiap kali deploy berhasil:
RUN_MIGRATIONS=true

# Jalankan seeder bawaan (UserSeeder, Polsek, CCTV, Kategori) saat pertama kali deploy:
# Aktifkan ini menjadi 'true' pada deploy pertama jika ingin akun admin langsung terbuat.
# Setelah berhasil, ubah kembali ke 'false'.
RUN_SEEDER=false

# ------------------------------------------------------------------------------
# SESSION, CACHE, & STORAGE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
FORCE_HTTPS=true
